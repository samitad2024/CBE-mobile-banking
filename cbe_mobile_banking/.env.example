# CBE Mobile Banking — environment template
# Copy to `.env` for local use. NEVER commit real `.env` files.
#
# Mock-first phase: values below are placeholders only.
# Prefer flutter_secure_storage for tokens/PINs at runtime (not plain .env).

# Environment name: mock | staging | production
APP_ENV=mock

# API base URL (unused while mock data is active)
API_BASE_URL=https://api.example.cbe.et

# Feature flags (optional)
ENABLE_BIOMETRICS=true
ENABLE_CLEARTEXT_DEBUG=false

# DO NOT put real client secrets, PIN seeds, or bearer tokens here.
